[Unit]
Description=Samba self-service password HTTPS API (Gunicorn)
After=network-online.target smb.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/samba-password-api
Environment=SAMBA_PASSWORD_CONFIG=/etc/samba-password-api/config.json
ExecStart=/usr/bin/gunicorn --workers 2 --threads 2 --bind 192.168.0.93:8443 --certfile /etc/samba-password-api/tls/server.crt --keyfile /etc/samba-password-api/tls/server.key --access-logfile - --error-logfile - samba_password_wsgi:app
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
