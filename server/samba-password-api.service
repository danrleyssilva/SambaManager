[Unit]
Description=Samba self-service password HTTPS API
After=network-online.target smb.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python /opt/samba-password-api/samba-password-api.py /etc/samba-password-api/config.json
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
